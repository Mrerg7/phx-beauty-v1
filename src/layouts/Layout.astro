---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  canonicalPath?: string;
  keywords?: string;
  noindex?: boolean;
}

const { title, description, ogImage, canonicalUrl, canonicalPath, keywords, noindex = false } = Astro.props;

const site = "https://phx.beauty";
const canonical = canonicalUrl || new URL(canonicalPath ?? Astro.url.pathname, site).toString();
const productImage =
  ogImage || "https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/cf14abf6-727d-4088-5ad4-8812c6c3c000/public";
const ctaEmail = "sales@desertrich.com";
const escrowMailto = `mailto:${ctaEmail}?subject=Inquiry%3A%20phx.beauty%20Domain%20Acquisition&body=I%20am%20interested%20in%20acquiring%20phx.beauty.%20Please%20send%20more%20information%20regarding%20pricing%20and%20next%20steps.`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site}/#organization`,
  name: "SDL Domains",
  url: site,
  email: ctaEmail,
  areaServed: "Phoenix, Arizona",
  sameAs: [
    "https://sdl.contact",
    "https://sdl.hair",
    "https://phx.beauty",
    "https://sdl.life",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site}/#website`,
  name: "phx.beauty",
  url: site,
  description,
  publisher: { "@id": `${site}/#organization` },
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${site}/#product`,
  name: "phx.beauty",
  description:
    "Premium short .beauty domain for luxury beauty, medspas, skincare and aesthetics in Phoenix/Scottsdale. Available for acquisition via confidential inquiry with secure escrow transfer.",
  brand: { "@type": "Brand", name: "SDL Domains" },
  category: "Domain Name > Premium .beauty Domain",
  image: [productImage],
  sku: "phx.beauty",
  url: canonical,
  offers: {
    "@type": "Offer",
    "@id": `${site}/#offer`,
    url: canonical,
    priceCurrency: "USD",
    price: "8000",
    priceValidUntil: "2027-08-23",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
    seller: { "@id": `${site}/#organization` },
    priceSpecification: {
      "@type": "PriceSpecification",
      priceCurrency: "USD",
      price: "8000",
      name: "Serious offers from $8,000",
    },
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is phx.beauty for sale?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. phx.beauty is available for acquisition by qualified buyers via confidential inquiry to sales@desertrich.com. Transfer is completed through a licensed escrow service.",
      },
    },
    {
      "@type": "Question",
      name: "How much does phx.beauty cost?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Serious offers from $8,000. Premium short geo-beauty domains in strong markets typically trade in the high five to low six figures. Submit your intended use and offer for a confidential response within 24–48 hours.",
      },
    },
    {
      "@type": "Question",
      name: "How is the domain transferred securely?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We use Escrow.com (or equivalent licensed escrow) with registrar push, Auth/EPP code, and full transfer. Funds are released only after you confirm control of the domain.",
      },
    },
    {
      "@type": "Question",
      name: "What is phx.beauty best used for?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Luxury medspas, aesthetics clinics, premium skincare brands, full-service beauty destinations, wellness and longevity clinics, and multi-location beauty groups in Phoenix/Scottsdale.",
      },
    },
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site + "/" },
    { "@type": "ListItem", position: 2, name: "FAQ", item: site + "/faq/" },
    {
      "@type": "ListItem",
      position: 3,
      name: "Domain Valuation Guide",
      item: site + "/valuation-guide/",
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <SEO
      title={title}
      description={description}
      image={productImage}
      url={canonical}
      keywords={keywords}
      canonicalPath={canonicalPath}
      noindex={noindex}
    />
    <StructuredData schema={[organizationSchema, websiteSchema, productSchema, faqSchema, breadcrumbSchema]} />
    <!-- Cloudflare Web Analytics (free, privacy-first). Replace token when available. -->
    <!-- <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "REPLACE_WITH_TOKEN"}'></script> -->
    <script is:inline>
      // Theme: persist + respect OS, default dark (hero is dark)
      (function () {
        try {
          var stored = localStorage.getItem("phx-theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var dark = stored ? stored === "dark" : true;
          if (dark) document.documentElement.classList.add("dark");
          else document.documentElement.classList.remove("dark");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-xl focus:bg-white focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-slate-900"
    >
      Skip to content
    </a>
    <!-- NAV (mobile hamburger + 48px targets + theme toggle) -->
    <nav class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md dark:border-white/10 dark:bg-slate-950/90" aria-label="Primary" id="navbar">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex h-16 items-center justify-between gap-2 sm:h-20">
          <a href="/" class="tap-target flex items-center gap-x-3 rounded-xl" aria-label="phx.beauty home">
            <div class="flex h-8 w-8 items-center justify-center rounded-2xl bg-slate-900 sm:h-9 sm:w-9 dark:bg-white">
              <span class="text-xl font-bold tracking-tighter text-white sm:text-2xl dark:text-slate-900">PHX</span>
            </div>
            <div class="text-lg font-semibold tracking-tighter text-slate-900 sm:text-xl dark:text-white">
              phx<span class="text-amber-700">.</span>beauty
            </div>
          </a>

          <div class="hidden items-center gap-x-8 text-sm font-medium md:flex">
            <a href="/#why" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Why This Domain</a>
            <a href="/#perfect-for" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Perfect For</a>
            <a href="/#portfolio" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Portfolio</a>
            <a href="/faq/" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">FAQ</a>
            <a href="/#inquire" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Inquire</a>
          </div>

          <div class="flex items-center gap-x-2">
            <button
              id="theme-toggle"
              type="button"
              class="tap-target inline-flex items-center justify-center rounded-2xl border border-slate-300 px-3 text-sm dark:border-white/15"
              aria-label="Toggle dark mode"
              title="Toggle dark / light mode"
            >
              <span id="theme-icon" aria-hidden="true">◐</span>
            </button>
            <a
              href="https://sdl.contact"
              target="_blank"
              rel="noreferrer"
              class="tap-target hidden items-center rounded-3xl border border-slate-300 px-4 text-xs font-medium text-slate-600 transition hover:bg-slate-100 md:inline-flex dark:border-white/15 dark:text-slate-300"
            >
              SDL Portfolio
            </a>
            <a
              href="/#inquire"
              data-track="cta-nav-make-offer"
              class="tap-target inline-flex items-center rounded-3xl bg-slate-900 px-4 text-xs font-semibold text-white transition hover:bg-black sm:px-5 sm:text-sm dark:bg-white dark:text-slate-900"
            >
              Make an Offer
            </a>
            <button
              id="menu-button"
              type="button"
              class="tap-target inline-flex items-center justify-center rounded-2xl border border-slate-300 px-3 text-xl md:hidden dark:border-white/15"
              aria-expanded="false"
              aria-controls="mobile-menu"
              aria-label="Open menu"
            >
              ☰
            </button>
          </div>
        </div>
      </div>
      <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-6 py-4 md:hidden dark:border-white/10 dark:bg-slate-950">
        <div class="grid gap-1 text-base font-medium">
          <a href="/#why" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Why This Domain</a>
          <a href="/#perfect-for" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Perfect For</a>
          <a href="/#portfolio" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Portfolio</a>
          <a href="/faq/" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">FAQ</a>
          <a href="/valuation-guide/" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Valuation Guide</a>
          <a href="/#inquire" data-track="cta-mobile-inquire" class="tap-target flex items-center rounded-xl px-2 font-semibold text-amber-700">Inquire to Purchase →</a>
        </div>
      </div>
    </nav>

    <slot />

    <!-- FOOTER -->
    <footer class="border-t border-slate-100 bg-white py-10 text-slate-800 dark:border-white/10 dark:bg-slate-950 dark:text-slate-300">
      <div class="mx-auto max-w-5xl px-6">
        <div class="grid gap-6 md:grid-cols-[1.2fr_1fr]">
          <div>
            <h2 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-white">Domain available for acquisition</h2>
            <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
              For qualified buyers, acquisition inquiries for <span class="font-medium text-slate-900 dark:text-white">phx.beauty</span>
              should be routed directly to
              <a class="font-medium text-amber-700 hover:text-amber-800" href={escrowMailto}>{ctaEmail}</a>.
              This is a premium digital asset intended for serious buyers only.
            </p>
            <p class="mt-3 text-xs text-slate-400">
              © 2026 SDL Domains • Phoenix / Scottsdale, Arizona •
              <a class="hover:underline" href="/faq/">FAQ</a> •
              <a class="hover:underline" href="/valuation-guide/">Valuation</a>
            </p>
          </div>
          <div>
            <div class="font-semibold text-slate-900 dark:text-white">SDL Portfolio</div>
            <ul class="mt-3 space-y-2 text-sm">
              <li><a href="https://sdl.contact" target="_blank" rel="noreferrer" class="tap-target inline-flex items-center text-amber-700 hover:text-amber-800">sdl.contact</a></li>
              <li><a href="https://sdl.hair" target="_blank" rel="noreferrer" class="tap-target inline-flex items-center text-amber-700 hover:text-amber-800">sdl.hair</a></li>
              <li><a href="https://sdl.life" target="_blank" rel="noreferrer" class="tap-target inline-flex items-center text-amber-700 hover:text-amber-800">sdl.life</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-xs leading-5 text-slate-500 dark:border-white/10 dark:bg-slate-900 dark:text-slate-400">
          This website is for demonstration and informational purposes only. It does not constitute an offer of services,
          a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to specific
          technologies are based on publicly available information as of the date shown and are subject to change.
        </div>
      </div>
    </footer>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        var root = document.documentElement;

        var toggle = document.getElementById("theme-toggle");
        if (toggle) {
          toggle.addEventListener("click", function () {
            var dark = !root.classList.contains("dark");
            root.classList.toggle("dark", dark);
            try { localStorage.setItem("phx-theme", dark ? "dark" : "light"); } catch (e) {}
          });
        }

        var btn = document.getElementById("menu-button");
        var menu = document.getElementById("mobile-menu");
        if (btn && menu) {
          btn.addEventListener("click", function () {
            var open = menu.classList.toggle("hidden");
            btn.setAttribute("aria-expanded", String(!open));
            btn.setAttribute("aria-label", open ? "Open menu" : "Close menu");
          });
          menu.querySelectorAll("a").forEach(function (a) {
            a.addEventListener("click", function () {
              menu.classList.add("hidden");
              btn.setAttribute("aria-expanded", "false");
            });
          });
        }

        var nav = document.getElementById("navbar");
        if (nav) {
          window.addEventListener("scroll", function () {
            if (window.scrollY > 20) nav.classList.add("shadow-sm");
            else nav.classList.remove("shadow-sm");
          }, { passive: true });
        }

        document.getElementById("copy-email-btn")?.addEventListener("click", async function () {
          try {
            await navigator.clipboard.writeText("sales@desertrich.com");
            var label = document.getElementById("copy-label");
            if (label) {
              var original = label.textContent;
              label.textContent = "Copied!";
              setTimeout(function () { label.textContent = original; }, 2000);
            }
          } catch (e) {
            var ta = document.createElement("textarea");
            ta.value = "sales@desertrich.com";
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand("copy"); } catch (_e) {}
            document.body.removeChild(ta);
          }
        });
      });
    </script>
  </body>
</html>
