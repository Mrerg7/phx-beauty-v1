---
import Layout from '../layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "phx.beauty",
  "description": "Premium short .beauty domain for luxury beauty, medspa, skincare, and aesthetics in the Phoenix / Scottsdale market.",
  "url": "https://phx.beauty",
  "brand": {
    "@type": "Brand",
    "name": "SDL Domains"
  },
  "category": "Digital Asset",
  "audience": {
    "@type": "BusinessAudience",
    "geographicArea": {
      "@type": "City",
      "name": "Phoenix/Scottsdale",
      "addressRegion": "AZ",
      "addressCountry": "US"
    }
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "price": "0",
    "priceCurrency": "USD",
    "seller": {
      "@type": "Organization",
      "name": "SDL Domains",
      "email": "sales@desertrich.com",
      "url": "https://sdl.contact"
    }
  }
};
---

<Layout
  title="phx.beauty | Premium Short .beauty Domain for Luxury Beauty &amp; Aesthetics • Phoenix/Scottsdale"
  description="phx.beauty — A short, premium, geo-relevant .beauty domain perfect for a luxury medspa, skincare brand, aesthetics clinic, or high-end beauty destination in the Phoenix / Scottsdale market. Serious inquiries only."
  canonicalUrl="https://phx.beauty/"
  schema={structuredData}
>
  <!-- HERO -->
  <header class="relative min-h-[620px] md:min-h-[680px] flex items-center overflow-hidden bg-slate-950">
    <!-- Background -->
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://imagedelivery.net/placeholder/phx-beauty-hero/1920x1080')">
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/70"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-slate-950/30"></div>
    </div>

    <div class="relative max-w-5xl mx-auto px-6 pt-8 md:pt-0">
      <div class="max-w-3xl">
        <!-- Badge -->
        <div class="inline-flex items-center gap-x-2 bg-white/10 backdrop-blur-md border border-white/20 px-4 py-1.5 rounded-3xl mb-8">
          <div class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></div>
          <span class="text-xs font-semibold tracking-[1.5px] text-white/90">PREMIUM .BEAUTY DOMAIN &bull; PHOENIX / SCOTTSDALE</span>
        </div>

        <h1 class="text-white">
          <span class="block domain-name">phx.beauty</span>
        </h1>

        <p class="mt-4 max-w-lg text-2xl text-white/90 tracking-tight">
          The premium short domain for luxury beauty,<br />medspas &amp; aesthetics in the Phoenix metro.
        </p>

        <div class="mt-9 flex flex-wrap gap-4">
          <a href="#inquire"
             class="px-10 py-4 bg-white text-slate-900 hover:bg-amber-50 font-semibold rounded-3xl text-base transition-all active:scale-[0.985] shadow-xl">
            Inquire to Purchase
          </a>
          <a href="#why"
             class="px-8 py-4 border border-white/30 hover:bg-white/10 text-white font-semibold rounded-3xl text-base transition-all">
            Why phx.beauty
          </a>
        </div>

        <div class="mt-8 flex items-center gap-x-6 text-xs text-white/60">
          <div class="flex items-center gap-x-2">
            <span class="font-mono">PHOENIX &bull; SCOTTSDALE</span>
          </div>
          <div class="w-px h-3 bg-white/30"></div>
          <div>Short &bull; Brandable &bull; Exact-match .beauty</div>
        </div>
      </div>
    </div>
  </header>

  <!-- TRUST / QUICK STATS -->
  <div class="border-b border-slate-200 bg-white">
    <div class="max-w-5xl mx-auto px-6 py-6">
      <div class="flex flex-wrap justify-center md:justify-between items-center gap-x-10 gap-y-4 text-center md:text-left text-sm">
        <div class="flex items-center gap-x-3">
          <div class="text-emerald-600">&bullet;</div>
          <span class="font-medium">Premium short .beauty domain</span>
        </div>
        <div class="hidden md:block text-slate-300">&bull;</div>
        <div>Ideal for medspas, skincare, aesthetics &amp; luxury beauty</div>
        <div class="hidden md:block text-slate-300">&bull;</div>
        <div>Strong positioning in Phoenix &amp; Scottsdale&rsquo;s affluent market</div>
      </div>
    </div>
  </div>

  <!-- THE OPPORTUNITY -->
  <div class="max-w-5xl mx-auto px-6 pt-16 pb-12" id="why">
    <div class="max-w-2xl">
      <div class="uppercase tracking-[2px] text-xs font-semibold text-amber-700 mb-3">THE OPPORTUNITY</div>
      <h2 class="text-5xl tracking-tighter font-semibold heading-serif">Own the digital<br />flagship for beauty in PHX.</h2>
      <p class="mt-5 text-lg text-slate-600">phx.beauty is short, elegant, instantly brandable, and perfectly aligned with the booming luxury beauty, medspa, skincare, and aesthetics industry in the Phoenix metropolitan area. &ldquo;PHX&rdquo; delivers immediate local recognition while the .beauty extension signals premium positioning in one of the Southwest&rsquo;s most affluent and style-conscious markets.</p>
    </div>

    <div class="mt-12 grid md:grid-cols-3 gap-5">
      <div class="value-card bg-white border border-slate-200 rounded-3xl p-7">
        <div class="text-amber-700 text-xs tracking-widest font-semibold mb-3">BRAND POWER</div>
        <div class="font-semibold text-xl tracking-tight">Instant local + industry authority</div>
        <p class="mt-3 text-sm text-slate-600">Four characters. Clear geo signal via &ldquo;PHX&rdquo;. Exact-match .beauty relevance. Easy to say, spell, type, and remember across marketing channels.</p>
      </div>
      <div class="value-card bg-white border border-slate-200 rounded-3xl p-7">
        <div class="text-amber-700 text-xs tracking-widest font-semibold mb-3">MARKET FIT</div>
        <div class="font-semibold text-xl tracking-tight">Phoenix / Scottsdale luxury</div>
        <p class="mt-3 text-sm text-slate-600">The Valley is home to high-net-worth residents, strong medical aesthetics demand, resort visitors, and a growing appetite for premium skincare, injectables, and wellness experiences.</p>
      </div>
      <div class="value-card bg-white border border-slate-200 rounded-3xl p-7">
        <div class="text-amber-700 text-xs tracking-widest font-semibold mb-3">FUTURE-PROOF</div>
        <div class="font-semibold text-xl tracking-tight">Purpose-built .beauty TLD</div>
        <p class="mt-3 text-sm text-slate-600">.beauty is the natural home for medspas, skincare brands, aesthetics clinics, full-service salons, and beauty wellness concepts. Growing adoption with excellent long-term equity.</p>
      </div>
    </div>
  </div>

  <!-- PERFECT FOR -->
  <div class="bg-white border-y border-slate-100 py-16" id="perfect-for">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-xl mb-10">
        <div class="uppercase tracking-[2px] text-xs font-semibold text-amber-700 mb-3">IDEAL USE CASES</div>
        <h2 class="text-4xl tracking-tighter font-semibold">Designed for leaders in beauty &amp; aesthetics.</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <div class="group border border-slate-200 hover:border-amber-200 transition-colors rounded-3xl p-7 bg-white">
          <div class="text-3xl mb-4">&hearts;</div>
          <div class="font-semibold text-xl tracking-tight">Luxury Medspa or Aesthetics Clinic</div>
          <p class="mt-3 text-sm text-slate-600">Flagship domain for a high-end medspa in Scottsdale, Paradise Valley, Arcadia, or North Phoenix offering Botox, fillers, lasers, and advanced treatments.</p>
          <div class="mt-5 text-xs font-medium text-amber-700 group-hover:underline">Instant credibility with discerning clients &rarr;</div>
        </div>

        <div class="group border border-slate-200 hover:border-amber-200 transition-colors rounded-3xl p-7 bg-white">
          <div class="text-3xl mb-4">&#9827;</div>
          <div class="font-semibold text-xl tracking-tight">Premium Skincare Brand</div>
          <p class="mt-3 text-sm text-slate-600">Launch or elevate a luxury skincare, cosmeceutical, or clean beauty line with strong local Phoenix roots and national expansion potential.</p>
          <div class="mt-5 text-xs font-medium text-amber-700 group-hover:underline">E-commerce + retail ready &rarr;</div>
        </div>

        <div class="group border border-slate-200 hover:border-amber-200 transition-colors rounded-3xl p-7 bg-white">
          <div class="text-3xl mb-4">&clubs;</div>
          <div class="font-semibold text-xl tracking-tight">Full-Service Beauty Destination</div>
          <p class="mt-3 text-sm text-slate-600">Ideal for an integrated luxury beauty concept combining medspa services, hair, skincare, and wellness under one premium brand.</p>
          <div class="mt-5 text-xs font-medium text-amber-700 group-hover:underline">Multi-service, high-ticket positioning &rarr;</div>
        </div>

        <div class="group border border-slate-200 hover:border-amber-200 transition-colors rounded-3xl p-7 bg-white">
          <div class="text-3xl mb-4">&#9733;</div>
          <div class="font-semibold text-xl tracking-tight">Wellness &amp; Longevity Clinic</div>
          <p class="mt-3 text-sm text-slate-600">Perfect for hormone optimization, IV therapy, peptide, or longevity-focused beauty &amp; wellness practices targeting the active 55+ and high-performance communities.</p>
          <div class="mt-5 text-xs font-medium text-amber-700 group-hover:underline">Medical wellness crossover &rarr;</div>
        </div>

        <div class="group border border-slate-200 hover:border-amber-200 transition-colors rounded-3xl p-7 bg-white">
          <div class="text-3xl mb-4">&#9830;</div>
          <div class="font-semibold text-xl tracking-tight">Resort or Hospitality Beauty Concept</div>
          <p class="mt-3 text-sm text-slate-600">Pair with a luxury resort, private club, or high-end hospitality group for an exclusive on-site or branded beauty experience in the Valley.</p>
          <div class="mt-5 text-xs font-medium text-amber-700 group-hover:underline">Hospitality + beauty synergy &rarr;</div>
        </div>

        <div class="group border border-slate-200 hover:border-amber-200 transition-colors rounded-3xl p-7 bg-white">
          <div class="text-3xl mb-4">&spades;</div>
          <div class="font-semibold text-xl tracking-tight">Multi-Location Beauty Group</div>
          <p class="mt-3 text-sm text-slate-600">Scalable brand for a growing network of salons, medspas, or aesthetics locations across Phoenix, Scottsdale, and the East/West Valley.</p>
          <div class="mt-5 text-xs font-medium text-amber-700 group-hover:underline">Portfolio &amp; expansion ready &rarr;</div>
        </div>
      </div>
    </div>
  </div>

  <!-- MARKET CONTEXT -->
  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-12 gap-x-12 items-center">
      <div class="md:col-span-7">
        <div class="uppercase tracking-[2px] text-xs font-semibold text-amber-700 mb-3">THE MARKET</div>
        <h2 class="text-4xl tracking-tighter font-semibold">Phoenix &amp; Scottsdale represent one of the strongest luxury beauty markets in the Southwest.</h2>
        <p class="mt-5 text-slate-600">With a large affluent population, strong medical aesthetics demand, year-round resort and golf visitors, a vibrant 55+ active adult community, and growing interest in longevity and wellness, the Valley continues to support premium beauty and self-care concepts at a high level.</p>

        <div class="mt-8 grid grid-cols-3 gap-6 text-sm">
          <div>
            <div class="font-mono text-3xl font-semibold tracking-tighter text-slate-900">Strong</div>
            <div class="text-xs text-slate-500 mt-1">demand for medspa,<br />injectables &amp; skincare</div>
          </div>
          <div>
            <div class="font-mono text-3xl font-semibold tracking-tighter text-slate-900">High</div>
            <div class="text-xs text-slate-500 mt-1">disposable income &amp;<br />wellness spending</div>
          </div>
          <div>
            <div class="font-mono text-3xl font-semibold tracking-tighter text-slate-900">Growing</div>
            <div class="text-xs text-slate-500 mt-1">longevity &amp; aesthetic<br />medicine interest</div>
          </div>
        </div>
      </div>

      <div class="md:col-span-5 mt-10 md:mt-0">
        <div class="bg-slate-900 text-white rounded-3xl p-8 text-sm">
          <div class="uppercase tracking-widest text-xs text-white/50 mb-5">KEY ADVANTAGES OF phx.beauty</div>
          <ul class="space-y-4 text-white/90">
            <li class="flex gap-x-3"><span class="text-amber-400 mt-1">&rarr;</span> Short, premium, and instantly brandable</li>
            <li class="flex gap-x-3"><span class="text-amber-400 mt-1">&rarr;</span> Clear Phoenix / Scottsdale geo relevance</li>
            <li class="flex gap-x-3"><span class="text-amber-400 mt-1">&rarr;</span> Exact-match .beauty industry signal</li>
            <li class="flex gap-x-3"><span class="text-amber-400 mt-1">&rarr;</span> Professional email (@phx.beauty) builds instant trust</li>
            <li class="flex gap-x-3"><span class="text-amber-400 mt-1">&rarr;</span> Strong foundation for local + national growth</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- INQUIRY / CONVERSION SECTION -->
  <div class="bg-slate-900 py-16" id="inquire">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10">
        <div class="inline px-4 py-1 rounded-3xl bg-white/10 text-white text-xs tracking-[1.5px] font-medium mb-4">SERIOUS INQUIRIES ONLY</div>
        <h2 class="text-white text-4xl md:text-5xl tracking-tighter font-semibold">Ready to own phx.beauty?</h2>
        <p class="mt-4 text-white/70 max-w-md mx-auto">Premium geo + industry domains in strong markets like Phoenix move quickly. Submit your inquiry and we&rsquo;ll respond promptly with details and next steps.</p>
      </div>

      <form action="mailto:sales@desertrich.com" method="post" enctype="text/plain" class="bg-white rounded-3xl p-8 md:p-10 shadow-xl">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
          <div>
            <label class="block text-xs font-semibold tracking-wider text-slate-500 mb-2">YOUR NAME</label>
            <input type="text" name="name" required placeholder="Jordan Hale"
                   class="w-full border border-slate-200 rounded-2xl px-5 py-3.5 text-sm placeholder:text-slate-400 focus:border-amber-700 focus:ring-3 focus:ring-amber-700/10 outline-none transition-all" />
          </div>
          <div>
            <label class="block text-xs font-semibold tracking-wider text-slate-500 mb-2">EMAIL ADDRESS</label>
            <input type="email" name="email" required placeholder="you@yourbrand.com"
                   class="w-full border border-slate-200 rounded-2xl px-5 py-3.5 text-sm placeholder:text-slate-400 focus:border-amber-700 focus:ring-3 focus:ring-amber-700/10 outline-none transition-all" />
          </div>
        </div>

        <div class="mt-6">
          <label class="block text-xs font-semibold tracking-wider text-slate-500 mb-2">INTENDED USE FOR phx.beauty</label>
          <select name="use-case" required class="w-full border border-slate-200 rounded-2xl px-5 py-3.5 text-sm text-slate-700 focus:border-amber-700 focus:ring-3 focus:ring-amber-700/10 outline-none transition-all">
            <option value="">Select best fit...</option>
            <option>Luxury Medspa or Aesthetics Clinic (Phoenix/Scottsdale)</option>
            <option>Premium Skincare or Cosmeceutical Brand</option>
            <option>Full-Service Luxury Beauty Destination</option>
            <option>Wellness, Longevity or Hormone Optimization Clinic</option>
            <option>Multi-Location Beauty or Medspa Group</option>
            <option>Resort / Hospitality Beauty Concept</option>
            <option>Other (please describe below)</option>
          </select>
        </div>

        <div class="mt-6">
          <label class="block text-xs font-semibold tracking-wider text-slate-500 mb-2">YOUR OFFER (USD)</label>
          <div class="relative">
            <div class="absolute left-5 top-3.5 text-slate-400">$</div>
            <input type="number" name="offer" placeholder="22000" min="8000" step="500"
                   class="w-full border border-slate-200 rounded-2xl pl-9 pr-5 py-3.5 text-sm placeholder:text-slate-400 focus:border-amber-700 focus:ring-3 focus:ring-amber-700/10 outline-none transition-all" />
          </div>
          <div class="text-[10px] text-slate-400 mt-1.5 px-1">Serious offers only. Premium short .beauty and geo-beauty domains in strong markets typically trade in the high five to low six figures.</div>
        </div>

        <div class="mt-6">
          <label class="block text-xs font-semibold tracking-wider text-slate-500 mb-2">ADDITIONAL DETAILS OR VISION (OPTIONAL)</label>
          <textarea name="message" rows="3" placeholder="Planning to launch a flagship medspa + skincare concept in North Scottsdale with strong longevity and aesthetics focus..."
                    class="w-full border border-slate-200 rounded-2xl px-5 py-3.5 text-sm placeholder:text-slate-400 resize-y focus:border-amber-700 focus:ring-3 focus:ring-amber-700/10 outline-none transition-all"></textarea>
        </div>

        <div class="mt-8">
          <button type="submit"
                  class="w-full py-4 bg-slate-900 hover:bg-black active:bg-slate-950 transition-all text-white font-semibold rounded-3xl text-base tracking-wide">
            SUBMIT INQUIRY
          </button>
        </div>

        <p class="text-center text-xs text-slate-400 mt-5">We typically respond within 24&ndash;48 hours. All inquiries are confidential.</p>
        <p class="text-center text-xs text-slate-400 mt-2">Or email us directly: <a href="mailto:sales@desertrich.com" class="text-amber-700 hover:text-amber-800 font-medium">sales@desertrich.com</a></p>
      </form>
    </div>
  </div>

  <!-- CROSS PROMO -->
  <div class="max-w-4xl mx-auto px-6 py-16 text-center">
    <div class="max-w-md mx-auto">
      <p class="text-sm text-slate-500">Part of the SDL family of premium Phoenix / Scottsdale-focused domains</p>
      <div class="mt-4 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
        <a href="https://sdl.contact" target="_blank" class="font-medium text-amber-700 hover:text-amber-800">sdl.contact &rarr; Scottsdale Directory</a>
        <span class="text-slate-300 hidden md:inline">&bull;</span>
        <a href="https://sdl.hair" target="_blank" class="font-medium text-amber-700 hover:text-amber-800">sdl.hair &rarr; Premium Hair Domain</a>
      </div>
    </div>
  </div>
</Layout>
