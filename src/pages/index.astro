---
import Layout from '../layouts/Layout.astro';

const productImage = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/cf14abf6-727d-4088-5ad4-8812c6c3c000/public';

const title = "phx.beauty | Premium Domain for Sale | SDL Luxury Beauty Phoenix";
const metaDescription =
  "phx.beauty for sale — premium short .beauty domain for Phoenix/Scottsdale medspas, skincare & aesthetics. Serious offers from $8,000. Secure escrow transfer. Inquire now — 1 of 1 asset.";
const keywords =
  "buy .beauty domains, phx.beauty for sale, premium domain names, Phoenix beauty domain, Scottsdale medspa domain, luxury skincare domain, aesthetics clinic domain, investment domains, brandable domains, domain marketplace";

const ctaEmail = "sales@desertrich.com";
const escrowMailto = `mailto:${ctaEmail}?subject=Inquiry%3A%20phx.beauty%20Domain%20Acquisition&body=I%20am%20interested%20in%20acquiring%20phx.beauty.%20Please%20send%20more%20information%20regarding%20pricing%20and%20next%20steps.`;
---

<Layout
  title={title}
  description={metaDescription}
  ogImage={productImage}
  canonicalPath="/"
  keywords={keywords}
>
  <!-- ============ HERO / ABOVE THE FOLD ============ -->
  <header class="hero relative flex min-h-[640px] items-center overflow-hidden bg-slate-950 md:min-h-[700px]">
    <div class="hero-parallax" aria-hidden="true">
      <div class="hero-parallax__image-wrap" id="hero-parallax-wrap">
        <img
          id="hero-parallax-image"
          class="hero-parallax__image"
          src={productImage}
          alt=""
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero-parallax__overlay"></div>
    </div>

    <div id="main" class="relative z-10 mx-auto w-full max-w-5xl px-4 py-24 sm:px-6 md:py-0">
      <div class="max-w-3xl">
        <div class="mb-6 inline-flex max-w-full flex-wrap items-center gap-x-2 gap-y-1 rounded-3xl border border-white/20 bg-white/10 px-4 py-1.5 backdrop-blur-md sm:mb-8">
          <div class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400" aria-hidden="true"></div>
          <span class="text-[10px] font-semibold tracking-[1px] text-white/90 sm:text-xs sm:tracking-[1.5px]">
            PREMIUM .BEAUTY DOMAIN • PHOENIX / SCOTTSDALE • 1 OF 1 ASSET
          </span>
        </div>

        <h1 class="text-white">
          <span class="domain-name block">phx.beauty</span>
          <span class="mt-3 block max-w-xl text-lg font-normal tracking-tight text-white/95 sm:text-xl md:text-2xl">
            The premium short domain for luxury beauty, medspas &amp; aesthetics in the Phoenix metro.
          </span>
        </h1>

        <!-- Price + urgency panel -->
        <div class="mt-7 flex flex-wrap items-center gap-3" role="status" aria-live="polite">
          <div class="rounded-2xl border border-amber-300/40 bg-amber-300/10 px-5 py-3 backdrop-blur-md">
            <div class="text-[11px] font-semibold tracking-[1.5px] text-amber-200">SERIOUS OFFERS FROM $8,000</div>
            <div class="text-lg font-semibold text-white">Secure escrow transfer</div>
          </div>
          <div class="rounded-2xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
            <div class="text-sm font-semibold text-white"><span id="viewer-count">31</span> buyers viewed this week</div>
            <div class="text-xs text-white/70">Exclusive • First-come, confidential transfer</div>
          </div>
        </div>

        <!-- Triple CTA by price tier -->
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="#inquire"
            data-track="cta-hero-buy-now"
            class="tap-target inline-flex items-center justify-center rounded-3xl bg-white px-8 text-base font-semibold text-slate-900 shadow-xl transition hover:bg-amber-50"
          >
            Buy Now — Inquire
          </a>
          <a
            href="#inquire-offer"
            data-track="cta-hero-make-offer"
            class="tap-target inline-flex items-center justify-center rounded-3xl bg-amber-500 px-8 text-base font-semibold text-slate-950 shadow-xl transition hover:bg-amber-400"
          >
            Make an Offer
          </a>
          <a
            href={escrowMailto}
            data-track="cta-hero-contact-agent"
            class="tap-target inline-flex items-center justify-center rounded-3xl border border-white/30 px-8 text-base font-semibold text-white transition hover:bg-white/10"
          >
            Contact Agent
          </a>
        </div>

        <!-- Trust signals -->
        <ul class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-white/75" aria-label="Buyer protections">
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">🔒</span> Secure Escrow.com transfer</li>
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">✓</span> SSL &amp; verified ownership</li>
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">🤝</span> Transaction guarantee</li>
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">⚡</span> Response in 24–48h</li>
        </ul>

        <div class="mt-6 flex flex-col gap-2 text-xs text-white/60 sm:flex-row sm:items-center sm:gap-x-6">
          <div class="font-mono">PHOENIX • SCOTTSDALE</div>
          <div class="hidden h-3 w-px bg-white/30 sm:block" aria-hidden="true"></div>
          <div>Short • Brandable • Exact-match .beauty</div>
        </div>
      </div>
    </div>
  </header>

  <!-- Trust bar -->
  <div class="border-b border-slate-200 bg-white dark:border-white/10 dark:bg-slate-900">
    <div class="mx-auto max-w-5xl px-6 py-5">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-center text-sm md:justify-between md:text-left">
        <div class="flex items-center gap-x-2">
          <span class="font-medium text-emerald-600">Premium short .beauty domain</span>
        </div>
        <div class="hidden text-slate-300 md:block" aria-hidden="true">•</div>
        <div class="text-slate-600 dark:text-slate-300">Ideal for medspas, skincare, aesthetics &amp; luxury beauty</div>
        <div class="hidden text-slate-300 md:block" aria-hidden="true">•</div>
        <div class="text-slate-600 dark:text-slate-300">Strong positioning in Phoenix &amp; Scottsdale&rsquo;s affluent market</div>
      </div>
      <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-[11px] font-medium text-slate-500 dark:text-slate-400">
        <span class="rounded-full border border-slate-200 px-3 py-1.5 dark:border-white/10">Escrow.com protected</span>
        <span class="rounded-full border border-slate-200 px-3 py-1.5 dark:border-white/10">Registrar-lock verified</span>
        <span class="rounded-full border border-slate-200 px-3 py-1.5 dark:border-white/10">Confidential transfer</span>
        <a href="#faq" class="rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-amber-800 dark:bg-amber-950 dark:text-amber-200">How buying works →</a>
      </div>
    </div>
  </div>

  <main class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-200">
    <!-- WHY -->
    <section class="reveal mx-auto max-w-5xl px-6 pb-12 pt-16" id="why" aria-labelledby="why-heading">
      <div class="max-w-2xl">
        <div class="mb-3 text-xs font-semibold uppercase tracking-[2px] text-amber-700">The Opportunity</div>
        <h2 id="why-heading" class="heading-serif text-4xl font-semibold tracking-tighter text-slate-900 md:text-5xl dark:text-white">
          Own the digital<br />flagship for beauty in PHX.
        </h2>
        <p class="mt-5 text-lg text-slate-600 dark:text-slate-300">
          phx.beauty is short, elegant, instantly brandable, and perfectly aligned with the booming luxury beauty,
          medspa, skincare, and aesthetics industry in the Phoenix metropolitan area. &ldquo;PHX&rdquo; delivers
          immediate local recognition while the .beauty extension signals premium positioning in one of the
          Southwest&rsquo;s most affluent and style-conscious markets.
        </p>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
          New to premium domains? Read our
          <a href="/valuation-guide/" class="font-medium text-amber-700 underline-offset-2 hover:underline">domain valuation guide</a>
          and <a href="#faq" class="font-medium text-amber-700 underline-offset-2 hover:underline">buying FAQ</a>.
        </p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <div class="value-card rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-3 text-xs font-semibold tracking-widest text-amber-700">BRAND POWER</div>
          <div class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Instant local + industry authority</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
            Four characters. Clear geo signal via &ldquo;PHX&rdquo;. Exact-match .beauty relevance. Easy to say, spell, type, and remember across marketing channels.
          </p>
