            <button type="button" data-filter="beauty" class="portfolio-filter tap-target rounded-full border border-slate-200 px-4 text-sm font-medium dark:border-white/15" aria-pressed="false">Beauty</button>
            <button type="button" data-filter="brandable" class="portfolio-filter tap-target rounded-full border border-slate-200 px-4 text-sm font-medium dark:border-white/15" aria-pressed="false">Brandable</button>
          </div>
        </div>
        <ul id="portfolio-grid" class="grid gap-4 md:grid-cols-2">
          <li data-name="phx.beauty" data-category="geo beauty" data-tags="phoenix beauty medspa aesthetics" class="portfolio-card rounded-3xl border-2 border-amber-400 bg-amber-50 p-6 dark:bg-amber-950/30">
            <div class="flex items-center justify-between gap-3">
