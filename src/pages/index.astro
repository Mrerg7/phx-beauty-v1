  <!-- Exit-intent popup: email capture -->
  <div id="exit-popup" class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/70 p-6 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="exit-heading">
    <div class="w-full max-w-md rounded-3xl bg-white p-8 text-center dark:border dark:border-white/10 dark:bg-slate-900">
      <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-amber-100 text-2xl" aria-hidden="true">✦</div>
      <h2 id="exit-heading" class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Before you go…</h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Get the <strong>phx.beauty acquisition brief</strong> — comps, use cases &amp; escrow checklist. Plus first refusal if another offer lands.</p>
      <form id="exit-form" method="POST" action="/api/subscribe" class="mt-5 space-y-3">
        <label class="sr-only" for="exit-email">Email address</label>
        <input id="exit-email" name="email" type="email" required placeholder="you@yourbrand.com"
          class="tap-target w-full rounded-2xl border border-slate-200 px-5 text-base text-slate-900 dark:border-white/10 dark:bg-slate-950 dark:text-white" />
        <button type="submit" data-track="cta-exit-capture" class="tap-target w-full rounded-2xl bg-slate-900 py-3.5 text-sm font-semibold text-white dark:bg-white dark:text-slate-900">Send me the brief</button>
      </form>
      <p id="exit-success" class="mt-3 hidden text-sm font-medium text-emerald-600">You&rsquo;re on the list — check your inbox.</p>
      <button id="exit-close" type="button" class="tap-target mt-3 w-full rounded-2xl border border-slate-200 py-3 text-sm font-semibold dark:border-white/10">No thanks, I&rsquo;ll risk missing it</button>
    </div>
  </div>

  <script is:inline>
    function initHeroParallax() {
      var wrap = document.getElementById('hero-parallax-wrap');
      var image = document.getElementById('hero-parallax-image');
      var hero = document.querySelector('.hero');
      if (!wrap || !image || !hero) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var isMobile = window.matchMedia('(max-width: 767px)').matches;
      var strength = isMobile ? 0.12 : 0.22;
      var ticking = false;
      var update = function () {
        var rect = hero.getBoundingClientRect();
        var progress = Math.min(Math.max(-rect.top / (rect.height || 1), 0), 1);
        var offset = progress * rect.height * strength;
        image.style.transform = 'translate3d(0, ' + offset + 'px, 0) scale(1.06)';
        ticking = false;
      };
      var onScroll = function () {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
    initHeroParallax();

    document.addEventListener("DOMContentLoaded", function () {
      // Scroll reveal
      try {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add("is-visible"); io.unobserve(en.target); }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll(".reveal").forEach(function (el) { io.observe(el); });
      } catch (e) {
        document.querySelectorAll(".reveal").forEach(function (el) { el.classList.add("is-visible"); });
      }

      // Urgency: pseudo-live viewer count (stable per day + jitter, capped)
      try {
        var key = "phx-viewers";
        var today = new Date().toISOString().slice(0, 10);
        var raw = JSON.parse(localStorage.getItem(key) || "{}");
        if (raw.day !== today) {
          raw = { day: today, base: 24 + Math.floor(Math.random() * 16) };
          localStorage.setItem(key, JSON.stringify(raw));
        }
        var el = document.getElementById("viewer-count");
        if (el) el.textContent = String(raw.base);
      } catch (e) {}

      // Portfolio filter + search
      var filterBtns = Array.prototype.slice.call(document.querySelectorAll(".portfolio-filter"));
      var search = document.getElementById("portfolio-search");
      var cards = Array.prototype.slice.call(document.querySelectorAll(".portfolio-card"));
      var empty = document.getElementById("portfolio-empty");
      var active = "all";
      function applyFilter() {
        var q = (search && search.value || "").toLowerCase().trim();
        var shown = 0;
        cards.forEach(function (card) {
          var cat = (card.getAttribute("data-category") || "");
          var name = (card.getAttribute("data-name") || "").toLowerCase();
          var tags = (card.getAttribute("data-tags") || "").toLowerCase();
          var okCat = active === "all" || cat.indexOf(active) !== -1;
          var okQ = !q || name.indexOf(q) !== -1 || tags.indexOf(q) !== -1;
          var show = okCat && okQ;
          card.style.display = show ? "" : "none";
          if (show) shown++;
        });
        if (empty) empty.classList.toggle("hidden", shown !== 0);
      }
      filterBtns.forEach(function (b) {
        b.addEventListener("click", function () {
          active = b.getAttribute("data-filter") || "all";
          filterBtns.forEach(function (x) {
            var on = x === b;
            x.setAttribute("aria-pressed", String(on));
            x.className = "portfolio-filter tap-target rounded-full px-4 text-sm font-medium " + (on
              ? "bg-slate-900 text-white dark:bg-white dark:text-slate-900"
              : "border border-slate-200 dark:border-white/15");
          });
          applyFilter();
        });
      });
      if (search) search.addEventListener("input", applyFilter);

      // Inquiry form: validate -> POST /api/inquire -> mailto fallback -> success
      var form = document.getElementById("inquire-offer");
      if (form) {
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var err = document.getElementById("form-error");
          var ok = document.getElementById("form-success");
          var submit = document.getElementById("inquiry-submit");
          if (err) { err.classList.add("hidden"); err.textContent = ""; }
          if (ok) ok.classList.add("hidden");

          var name = document.getElementById("inquiry-name").value.trim();
          var email = document.getElementById("inquiry-email").value.trim();
          var useCase = document.getElementById("inquiry-use").value;
          var offer = document.getElementById("inquiry-offer").value;
          var message = document.getElementById("inquiry-message").value.trim();

          function fail(msg) {
            if (err) { err.textContent = msg; err.classList.remove("hidden"); }
            return false;
          }
          if (name.length < 2) return fail("Please enter your name.");
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return fail("Please enter a valid email address.");
          if (!useCase) return fail("Please select the intended use.");
          if (!offer || Number(offer) < 8000) return fail("Minimum serious offer is $8,000.");

          var original = submit.textContent;
          submit.textContent = "SENDING…";
          submit.disabled = true;

          fetch("/api/inquire", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name: name, email: email, useCase: useCase, offer: Number(offer), message: message })
          }).then(function (r) { return r.json().catch(function () { return { ok: r.ok }; }); }).then(function (data) {
            if (!data.ok && data.error) { fail(data.error); return; }
            if (ok) ok.classList.remove("hidden");
            form.reset();
            try {
              var s = "mailto:sales@desertrich.com?subject=" + encodeURIComponent("Inquiry: phx.beauty — $" + Number(offer).toLocaleString()) +
                "&body=" + encodeURIComponent("Name: " + name + "\nEmail: " + email + "\nUse: " + useCase + "\nOffer: $" + offer + "\n\n" + message);
              window.open(s, "_self");
            } catch (e2) {}
          }).catch(function () {
            if (ok) { ok.classList.remove("hidden"); }
            form.reset();
          }).finally(function () {
            submit.textContent = original;
            submit.disabled = false;
          });
        });
      }

      // Exit-intent popup (once per session, desktop mouseout + mobile timed fallback)
      try {
        var popup = document.getElementById("exit-popup");
        var closeBtn = document.getElementById("exit-close");
        var exitForm = document.getElementById("exit-form");
        var shown = sessionStorage.getItem("phx-exit-shown");
        function open() {
          if (sessionStorage.getItem("phx-exit-shown") || !popup) return;
          popup.classList.remove("hidden");
          popup.classList.add("flex");
          sessionStorage.setItem("phx-exit-shown", "1");
        }
        function hide() {
          if (!popup) return;
          popup.classList.add("hidden");
          popup.classList.remove("flex");
        }
        if (!shown) {
          document.addEventListener("mouseout", function (e) {
            if (!e.relatedTarget && e.clientY <= 0) open();
          });
          setTimeout(function () {
            if (window.innerWidth < 768 && !sessionStorage.getItem("phx-exit-shown")) {
              var deep = window.scrollY > document.body.scrollHeight * 0.4;
              if (deep) open();
            }
          }, 45000);
        }
        if (closeBtn) closeBtn.addEventListener("click", hide);
        if (popup) popup.addEventListener("click", function (e) { if (e.target === popup) hide(); });
        if (exitForm) exitForm.addEventListener("submit", function (e) {
          e.preventDefault();
          var emailInput = document.getElementById("exit-email");
          var email = emailInput.value.trim();
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { emailInput.focus(); return; }
          fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: email })
          }).catch(function () {}).finally(function () {
            var s = document.getElementById("exit-success");
            if (s) s.classList.remove("hidden");
            exitForm.reset();
            setTimeout(hide, 2500);
          });
        });
      } catch (e) {}

      // Lightweight CTA tracking hook (wire to analytics later)
      document.querySelectorAll("[data-track]").forEach(function (el) {
        el.addEventListener("click", function () {
          try { console.log(JSON.stringify({ type: "cta", id: el.getAttribute("data-track"), at: new Date().toISOString() })); } catch (e2) {}
        });
      });
    });
  </script>
</Layout>
