  <!-- Sticky mobile CTA -->
  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-200 bg-white/95 p-3 backdrop-blur-md md:hidden dark:border-white/10 dark:bg-slate-950/95">
    <div class="flex gap-2">
