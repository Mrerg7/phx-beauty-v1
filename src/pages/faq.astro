---
import Layout from "../layouts/Layout.astro";

const title = "phx.beauty FAQ | Buying a Premium Domain, Escrow & Transfer | SDL";
const description =
  "How to buy phx.beauty: pricing (offers from $8k), secure Escrow.com transfer, timelines, installments, and bundle options. Confidential replies in 24–48h.";
const image =
  "https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/cf14abf6-727d-4088-5ad4-8812c6c3c000/public";
---

<Layout
  title={title}
  description={description}
  ogImage={image}
  canonicalPath="/faq/"
  keywords="phx.beauty FAQ, how to buy a domain, escrow domain transfer, premium domain price, buy .beauty domains, domain acquisition"
>
  <main id="main" class="min-h-screen bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-200">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <a href="/" class="text-sm font-medium text-amber-700 hover:underline">← Back to phx.beauty</a>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[2px] text-amber-700">Buying FAQ</p>
      <h1 class="heading-serif mt-2 text-4xl font-semibold tracking-tighter text-slate-900 md:text-5xl dark:text-white">
        phx.beauty | Premium Domain for Sale — FAQ
      </h1>
      <p class="mt-4 text-slate-600 dark:text-slate-300">
        Everything serious buyers ask before acquiring phx.beauty. Ready?{" "}
        <a href="/#inquire-offer" class="font-semibold text-amber-700 hover:underline">Make an offer</a> or email{" "}
        <a href="mailto:sales@desertrich.com" class="font-semibold text-amber-700 hover:underline">sales@desertrich.com</a>.
      </p>

      <div class="mt-10 space-y-3">
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900" open>
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">Is phx.beauty for sale? <span class="faq-chevron">▾</span></summary>
          <p class="mt-3 text-sm">Yes. Confidential acquisition for qualified buyers. Transfer via licensed escrow (Escrow.com or equivalent).</p>
        </details>
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900">
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">What is the price? <span class="faq-chevron">▾</span></summary>
          <p class="mt-3 text-sm">Serious offers from $8,000. Premium short geo-beauty names in strong markets typically trade high five to low six figures. Include your intended use and offer for a 24–48h response.</p>
        </details>
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900">
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">How does escrow work? <span class="faq-chevron">▾</span></summary>
          <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm">
            <li>Agree price + sign escrow instructions.</li>
            <li>Buyer funds escrow.</li>
            <li>We push / Auth-code the domain to your registrar account.</li>
            <li>You confirm control → escrow releases funds.</li>
          </ol>
        </details>
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900">
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">How long does transfer take? <span class="faq-chevron">▾</span></summary>
          <p class="mt-3 text-sm">Same-registrar push: hours. Inter-registrar with Auth code: typically 1–5 days. Escrow adds 1–2 days for verification.</p>
        </details>
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900">
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">Installments or bundles? <span class="faq-chevron">▾</span></summary>
          <p class="mt-3 text-sm">Qualified buyers can request escrow-held installments. Portfolio bundles (phx.beauty + sdl.hair / sdl.contact / sdl.life) available — ask in your inquiry.</p>
        </details>
        <details class="faq rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-900">
          <summary class="tap-target flex cursor-pointer items-center justify-between gap-4 font-semibold">Why .beauty for Phoenix? <span class="faq-chevron">▾</span></summary>
          <p class="mt-3 text-sm">3-letter geo prefix + exact industry word. .beauty semantically owns medspa, skincare, and aesthetics — ideal for luxury beauty, wellness, and multi-location groups.</p>
        </details>
      </div>

      <div class="mt-10 rounded-3xl bg-slate-900 p-8 text-center dark:border dark:border-white/10 dark:bg-black">
        <h2 class="text-2xl font-semibold text-white">Ready to own phx.beauty?</h2>
        <a href="/#inquire-offer" class="tap-target mt-5 inline-flex items-center justify-center rounded-3xl bg-white px-8 font-semibold text-slate-900">Make an Offer →</a>
      </div>
    </div>
  </main>
</Layout>
